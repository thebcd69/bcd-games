diff --git a/src/kosmickrisp/vulkan/kk_opaque_fd.c b/src/kosmickrisp/vulkan/kk_opaque_fd.c
new file mode 100644
index 0000000..76bcd56
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_opaque_fd.c
@@ -0,0 +1,165 @@
+/*
+ * Copyright 2026 BCD contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * madeira-bcd: see kk_opaque_fd.h.
+ */
+#include "kk_opaque_fd.h"
+
+#include "kosmickrisp/bridge/mtl_bridge.h"
+
+#include "vk_sync_binary.h"
+
+#include "util/simple_mtx.h"
+
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define KK_OFD_MAGIC 0x3144464f4b4b4342ull /* "BCKKOFD1" */
+#define KK_OFD_MAX   1024
+
+struct kk_ofd_entry {
+   uint64_t key;
+   enum kk_ofd_kind kind;
+   const void *owner;
+   void *mtl;
+   uint64_t size;
+   struct vk_sync_binary_shared *shared;
+};
+
+static simple_mtx_t kk_ofd_mtx = SIMPLE_MTX_INITIALIZER;
+static struct kk_ofd_entry kk_ofd_entries[KK_OFD_MAX];
+static unsigned kk_ofd_count;
+static uint64_t kk_ofd_seq;
+static unsigned kk_ofd_logged;
+
+bool
+kk_opaque_fd_enabled(void)
+{
+   static int enabled = -1;
+
+   if (enabled < 0) {
+      const char *s = getenv("MADEIRA_KK_OPAQUE_FD");
+      int on = s && s[0] == '1' && !s[1];
+      if (on)
+         fprintf(stderr, "[kk-ofd] madeira-bcd MADEIRA_KK_OPAQUE_FD=1: "
+                         "VK_KHR_external_memory_fd and opaque fd semaphores "
+                         "(in-process handles for Wine's win32 sharing and "
+                         "Zink)\n");
+      enabled = on;
+   }
+   return enabled;
+}
+
+int
+kk_ofd_export(enum kk_ofd_kind kind, const void *owner, void *mtl,
+              uint64_t size, struct vk_sync_binary_shared *shared)
+{
+   const char *tmp = getenv("TMPDIR");
+   char path[PATH_MAX];
+   uint64_t header[2];
+   int fd;
+
+   snprintf(path, sizeof(path), "%s/kk-ofd-XXXXXX",
+            tmp && *tmp ? tmp : "/tmp");
+   fd = mkstemp(path);
+   if (fd < 0) {
+      fprintf(stderr, "[kk-ofd] cannot make a handle file in %s\n", path);
+      return -1;
+   }
+   unlink(path);
+   fcntl(fd, F_SETFD, FD_CLOEXEC);
+
+   simple_mtx_lock(&kk_ofd_mtx);
+   if (kk_ofd_count == KK_OFD_MAX) {
+      simple_mtx_unlock(&kk_ofd_mtx);
+      fprintf(stderr, "[kk-ofd] %u handles exported and alive: no more\n",
+              KK_OFD_MAX);
+      close(fd);
+      return -1;
+   }
+   header[0] = KK_OFD_MAGIC;
+   header[1] = ++kk_ofd_seq;
+   if (pwrite(fd, header, sizeof(header), 0) != sizeof(header)) {
+      simple_mtx_unlock(&kk_ofd_mtx);
+      close(fd);
+      return -1;
+   }
+   kk_ofd_entries[kk_ofd_count++] = (struct kk_ofd_entry){
+      .key = header[1],
+      .kind = kind,
+      .owner = owner,
+      .mtl = mtl_retain(mtl),
+      .size = size,
+      .shared = shared,
+   };
+   if (shared)
+      vk_sync_binary_shared_ref(shared);
+   if (kk_ofd_logged < 16) {
+      kk_ofd_logged++;
+      fprintf(stderr, "[kk-ofd] export #%llu %s %llu bytes (%u alive)\n",
+              (unsigned long long)header[1],
+              kind == KK_OFD_HEAP ? "memory" :
+              shared ? "binary semaphore" : "timeline semaphore",
+              (unsigned long long)size, kk_ofd_count);
+   }
+   simple_mtx_unlock(&kk_ofd_mtx);
+   return fd;
+}
+
+bool
+kk_ofd_lookup(int fd, enum kk_ofd_kind kind, void **mtl, uint64_t *size,
+              struct vk_sync_binary_shared **shared)
+{
+   uint64_t header[2];
+   bool found = false;
+
+   if (pread(fd, header, sizeof(header), 0) != sizeof(header) ||
+       header[0] != KK_OFD_MAGIC)
+      return false;
+
+   simple_mtx_lock(&kk_ofd_mtx);
+   for (unsigned i = 0; i < kk_ofd_count; i++) {
+      struct kk_ofd_entry *e = &kk_ofd_entries[i];
+      if (e->key != header[1] || e->kind != kind)
+         continue;
+      *mtl = mtl_retain(e->mtl);
+      if (size)
+         *size = e->size;
+      if (shared) {
+         *shared = e->shared;
+         if (e->shared)
+            vk_sync_binary_shared_ref(e->shared);
+      }
+      found = true;
+      break;
+   }
+   simple_mtx_unlock(&kk_ofd_mtx);
+   if (!found)
+      fprintf(stderr, "[kk-ofd] import #%llu: no such %s (its exporter is "
+                      "gone)\n", (unsigned long long)header[1],
+              kind == KK_OFD_HEAP ? "memory" : "semaphore");
+   return found;
+}
+
+void
+kk_ofd_forget(const void *owner)
+{
+   simple_mtx_lock(&kk_ofd_mtx);
+   for (unsigned i = 0; i < kk_ofd_count;) {
+      struct kk_ofd_entry *e = &kk_ofd_entries[i];
+      if (e->owner != owner) {
+         i++;
+         continue;
+      }
+      mtl_release(e->mtl);
+      if (e->shared)
+         vk_sync_binary_shared_unref(e->shared);
+      kk_ofd_entries[i] = kk_ofd_entries[--kk_ofd_count];
+   }
+   simple_mtx_unlock(&kk_ofd_mtx);
+}
diff --git a/src/kosmickrisp/vulkan/kk_opaque_fd.h b/src/kosmickrisp/vulkan/kk_opaque_fd.h
new file mode 100644
index 0000000..4e199bb
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_opaque_fd.h
@@ -0,0 +1,47 @@
+/*
+ * Copyright 2026 BCD contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * madeira-bcd: opaque fd handles for memory and semaphores inside one process.
+ *
+ * Metal objects cannot be turned into file descriptors, but every user of these
+ * handles in BCD (Wine's VK_KHR_external_memory_win32 / _semaphore_win32 and
+ * GL_EXT_memory_object / GL_EXT_semaphore through Zink) lives in the same
+ * process and loads this same library. An exported handle is the fd of an
+ * unlinked temporary file holding a key; the key names the MTLHeap or
+ * MTLSharedEvent in a table here. Wine passes such an fd through wineserver and
+ * back (the same open file), so the importer reads the key back with pread.
+ * Off unless MADEIRA_KK_OPAQUE_FD=1 (X-Plane 12's Vulkan/OpenGL bridge).
+ */
+#ifndef KK_OPAQUE_FD_H
+#define KK_OPAQUE_FD_H 1
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct vk_sync_binary_shared;
+
+enum kk_ofd_kind {
+   KK_OFD_HEAP = 1,  /* a VkDeviceMemory's MTLHeap */
+   KK_OFD_EVENT = 2, /* a semaphore's MTLSharedEvent */
+};
+
+/* MADEIRA_KK_OPAQUE_FD=1, read once. */
+bool kk_opaque_fd_enabled(void);
+
+/* A new fd naming `mtl` (retained by the table until kk_ofd_forget(owner));
+ * `shared` (a binary semaphore's shared point, or NULL) gets one more
+ * reference. -1 when no fd could be made. */
+int kk_ofd_export(enum kk_ofd_kind kind, const void *owner, void *mtl,
+                  uint64_t size, struct vk_sync_binary_shared *shared);
+
+/* What an fd names: the object retained for the caller, its size, and the
+ * shared point with one reference for the caller (NULL when none). False when
+ * the fd is not one of ours or its exporter is gone. The fd stays open. */
+bool kk_ofd_lookup(int fd, enum kk_ofd_kind kind, void **mtl, uint64_t *size,
+                   struct vk_sync_binary_shared **shared);
+
+/* The exporter `owner` is going away: drop its table entries. */
+void kk_ofd_forget(const void *owner);
+
+#endif
