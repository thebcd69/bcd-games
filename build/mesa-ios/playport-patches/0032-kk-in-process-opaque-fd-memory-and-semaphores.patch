index 73fd1f5..ccd9820 100644
--- a/src/kosmickrisp/vulkan/kk_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_buffer.c
@@ -8,7 +8,9 @@
 #include "kk_buffer.h"
 
 #include "kk_device.h"
+#include "kk_device_memory.h"
 #include "kk_entrypoints.h"
+#include "kk_opaque_fd.h"
 #include "kk_physical_device.h"
 
 #include "kosmickrisp/bridge/mtl_bridge.h"
@@ -133,6 +135,12 @@ kk_GetPhysicalDeviceExternalBufferProperties(
    case VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_MAPPED_FOREIGN_MEMORY_BIT_EXT:
       pExternalBufferProperties->externalMemoryProperties = kk_host_mem_props;
       return;
+   case VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT:   /* madeira-bcd */
+      if (!kk_opaque_fd_enabled())
+         goto unsupported;
+      pExternalBufferProperties->externalMemoryProperties =
+         kk_opaque_fd_mem_props;
+      return;
    default:
       goto unsupported;
    }
