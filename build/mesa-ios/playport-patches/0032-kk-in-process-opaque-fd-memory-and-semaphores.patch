+      pdev->sync_timeline_type = kk_sync_type;
+      pdev->sync_timeline_type.import_opaque_fd = kk_timeline_import_opaque_fd;
+      pdev->sync_timeline_type.export_opaque_fd = kk_timeline_export_opaque_fd;
+      timeline_type = &pdev->sync_timeline_type;
+   }
+   pdev->sync_binary_type = vk_sync_binary_get_type(timeline_type);
+   if (kk_opaque_fd_enabled()) {
+      pdev->sync_binary_type.sync.import_opaque_fd = kk_binary_import_opaque_fd;
+      pdev->sync_binary_type.sync.export_opaque_fd = kk_binary_export_opaque_fd;
+   }
    unsigned st_idx = 0;
-   pdev->sync_types[st_idx++] = &kk_sync_type;
