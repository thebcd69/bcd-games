+            present_id);
    }
 
    if (wsi_chain->wsi->sw) {
@@ -736,7 +763,19 @@ wsi_metal_swapchain_queue_present(struct wsi_swapchain *wsi_chain,
          image->base.row_pitches[0]);
    } else {
       /* Blit is already recorded, just present now */
-      wsi_metal_layer_present(&image->drawable);
+      if (vti_stand_in) {
+         /* madeira-bcd: the worker presents the frame (after the pictures it
