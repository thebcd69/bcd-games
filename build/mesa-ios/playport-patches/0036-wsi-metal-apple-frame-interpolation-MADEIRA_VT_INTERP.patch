+         wsi_metal_release_drawable(image->drawable);
+         image->drawable = NULL;
+      } else {
+         wsi_metal_layer_present(&image->drawable);
+      }
    }
 
    uint32_t width = 0u, height = 0u;
@@ -903,6 +942,7 @@ wsi_metal_swapchain_destroy(struct wsi_swapchain *wsi_chain,
    for (uint32_t i = 0; i < chain->base.image_count; i++) {
       struct wsi_metal_image *image = &chain->images[i];
       if (image->drawable) {
+         wsi_metal_vti_unpresented(image->drawable);   /* madeira-bcd: a stand-in goes back to its ring */
          wsi_metal_release_drawable(image->drawable);
          image->drawable = NULL;
       }
@@ -963,7 +1003,9 @@ wsi_metal_surface_create_swapchain(VkIcdSurfaceBase *icd_surface,
 #else
    const bool layer_opaque = opaque_composition && wsi_device->sw;
 #endif
-   const bool framebuffer_only = !wsi_device->sw;
+   /* madeira-bcd: with Apple frame interpolation asked for (MADEIRA_VT_INTERP),
