+         void *mtl4_queue = chain->base.wsi->metal.get_mtl4_command_queue ?
+            chain->base.wsi->metal.get_mtl4_command_queue(chain->base.device) : NULL;
+         wsi_metal_vti_present(mtl4_queue, image->drawable,
