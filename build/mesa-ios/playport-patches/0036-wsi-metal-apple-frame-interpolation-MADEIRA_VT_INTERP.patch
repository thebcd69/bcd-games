       }
@@ -721,11 +740,19 @@ wsi_metal_swapchain_queue_present(struct wsi_swapchain *wsi_chain,
 
    struct wsi_metal_image *image = &chain->images[image_index];
 
+   /* madeira-bcd: a stand-in of the interpolation module is presented by its
+    * worker from a drawable of the layer; the present-wait handler goes with it. */
+   const bool vti_stand_in = !wsi_chain->wsi->sw && wsi_metal_vti_is_stand_in(image->drawable);
