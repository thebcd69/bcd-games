          struct wsi_metal_image *image = &chain->images[i];
@@ -675,6 +693,7 @@ wsi_metal_swapchain_release_images(struct wsi_swapchain *wsi_chain,
       }
 
       if (image->drawable) {
+         wsi_metal_vti_unpresented(image->drawable);   /* madeira-bcd: a stand-in goes back to its ring */
          wsi_metal_release_drawable(image->drawable);
