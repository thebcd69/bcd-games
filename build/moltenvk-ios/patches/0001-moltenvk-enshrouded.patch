+			" -> strides %u / %u / %u (device max %u / %u / %u)\n", this,
+			(unsigned long)_perfTessVtxOutReflected, (unsigned long)tcInSize, (unsigned long)tcOutSize, (unsigned long)tcPatchOutSize,
+			_perfTessVtxOutStride, _perfTessCtlOutStride, _perfTessCtlPatchOutStride,
+			4 * limits.maxVertexOutputComponents, 4 * limits.maxTessellationControlPerVertexOutputComponents,
+			4 * limits.maxTessellationControlPerPatchOutputComponents);
