+void MVKGraphicsPipeline::initPerfTessStrides(NSUInteger tcInSize, NSUInteger tcOutSize, NSUInteger tcPatchOutSize) {
+	auto stride = [](NSUInteger size) -> uint32_t {
+		return (size >= 4 && size <= 65536) ? (uint32_t)mvkAlignByteCount(size, 16) : 0;
+	};
+	_perfTessVtxOutStride = _perfTessVtxOutReflected ? stride(std::max(_perfTessVtxOutReflected, tcInSize)) : 0;
+	_perfTessCtlOutStride = stride(tcOutSize);
+	_perfTessCtlPatchOutStride = stride(tcPatchOutSize);
