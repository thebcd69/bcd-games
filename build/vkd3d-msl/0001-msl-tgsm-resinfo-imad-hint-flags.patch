+/* madeira-bcd: the stride a shared memory register was declared with (raw: 4). */
+static unsigned int msl_tgsm_stride(struct msl_generator *gen, unsigned int id)
+{
+    unsigned int i;
+
+    for (i = 0; i < gen->tgsm_count; ++i)
+    {
+        if (gen->tgsm[i].id == id)
+            return gen->tgsm[i].stride;
+    }
+    msl_compiler_error(gen, VKD3D_SHADER_ERROR_MSL_INTERNAL,
+            "Internal compiler error: Undeclared thread group shared memory g%u.", id);
+    return 4;
+}
+
+/* madeira-bcd: the word index of element (index, byte offset) of shared memory register `id`. */
+static void msl_print_tgsm_address(struct vkd3d_string_buffer *buffer, struct msl_generator *gen,
+        unsigned int id, const struct vsir_src_operand *index, const struct vsir_src_operand *offset)
+{
+    vkd3d_string_buffer_printf(buffer, "((");
+    if (index)
+    {
+        msl_print_src_with_type(buffer, gen, index, VKD3DSP_WRITEMASK_0, VSIR_DATA_U32);
+        vkd3d_string_buffer_printf(buffer, " * %uu + ", msl_tgsm_stride(gen, id));
+    }
+    msl_print_src_with_type(buffer, gen, offset, VKD3DSP_WRITEMASK_0, VSIR_DATA_U32);
+    vkd3d_string_buffer_printf(buffer, ") >> 2)");
+}
+
+/* madeira-bcd: ld_structured / ld_raw from thread group shared memory. */
+static void msl_ld_tgsm(struct msl_generator *gen, const struct vkd3d_shader_instruction *ins, bool structured)
+{
+    const struct vsir_src_operand *resource = &ins->src[structured ? 2 : 1];
+    struct vkd3d_string_buffer *read, *address;
+    unsigned int id, i, n = 0;
+    struct msl_dst dst;
+    uint32_t mask;
+
+    if (resource->reg.type != VKD3DSPR_GROUPSHAREDMEM)
+    {
+        msl_unhandled(gen, ins);
+        return;
+    }
+    id = resource->reg.idx[0].offset;
+    mask = msl_dst_init(&dst, gen, ins, &ins->dst[0]);
+    address = vkd3d_string_buffer_get(&gen->string_buffers);
+    msl_print_tgsm_address(address, gen, id, structured ? &ins->src[0] : NULL, &ins->src[structured ? 1 : 0]);
+    read = vkd3d_string_buffer_get(&gen->string_buffers);
+    vkd3d_string_buffer_printf(read, "as_type<");
+    msl_print_resource_datatype(gen, read, ins->dst[0].reg.data_type);
+    if (vkd3d_popcount(mask) != 1)
+        vkd3d_string_buffer_printf(read, "%u", vkd3d_popcount(mask));
+    vkd3d_string_buffer_printf(read, ">(");
+    if (vkd3d_popcount(mask) != 1)
+        vkd3d_string_buffer_printf(read, "uint%u(", vkd3d_popcount(mask));
+    for (i = 0; i < VKD3D_VEC4_SIZE; ++i)
+    {
+        if (!(mask & (1u << i)))
+            continue;
+        vkd3d_string_buffer_printf(read, "%sg%u[%s + %uu]", n++ ? ", " : "", id, address->buffer,
+                vsir_swizzle_get_component(resource->swizzle, i));
+    }
+    if (vkd3d_popcount(mask) != 1)
+        vkd3d_string_buffer_printf(read, ")");
+    vkd3d_string_buffer_printf(read, ")");
+    msl_print_assignment(gen, &dst, "%s", read->buffer);
+    vkd3d_string_buffer_release(&gen->string_buffers, read);
+    vkd3d_string_buffer_release(&gen->string_buffers, address);
+    msl_dst_cleanup(&dst, &gen->string_buffers);
+}
+
+/* madeira-bcd: store_structured / store_raw to thread group shared memory. */
+static void msl_store_tgsm(struct msl_generator *gen, const struct vkd3d_shader_instruction *ins, bool structured)
+{
+    const struct vsir_src_operand *value = &ins->src[structured ? 2 : 1];
+    struct vkd3d_string_buffer *address, *component;
+    unsigned int id, i, n = 0;
+
+    if (ins->dst[0].reg.type != VKD3DSPR_GROUPSHAREDMEM)
+    {
+        msl_unhandled(gen, ins);
+        return;
+    }
+    id = ins->dst[0].reg.idx[0].offset;
+    address = vkd3d_string_buffer_get(&gen->string_buffers);
+    msl_print_tgsm_address(address, gen, id, structured ? &ins->src[0] : NULL, &ins->src[structured ? 1 : 0]);
+    for (i = 0; i < VKD3D_VEC4_SIZE; ++i)
+    {
+        if (!(ins->dst[0].write_mask & (1u << i)))
+            continue;
+        component = vkd3d_string_buffer_get(&gen->string_buffers);
+        /* word i takes the value's component at position i (its swizzle) */
+        msl_print_src_with_type(component, gen, value, 1u << i, VSIR_DATA_U32);
+        msl_print_indent(gen->buffer, gen->indent);
+        vkd3d_string_buffer_printf(gen->buffer, "g%u[%s + %uu] = %s;\n", id, address->buffer, i, component->buffer);
+        vkd3d_string_buffer_release(&gen->string_buffers, component);
+        ++n;
+    }
+    vkd3d_string_buffer_release(&gen->string_buffers, address);
+}
