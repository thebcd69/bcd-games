+/* madeira-bcd: resinfo on a 2D texture (width, height, 0, mip levels), as float, uint or 1 / float. */
+static void msl_resinfo(struct msl_generator *gen, const struct vkd3d_shader_instruction *ins)
+{
+    const struct msl_resource_type_info *resource_type_info;
+    const struct vkd3d_shader_descriptor_info1 *descriptor;
+    enum vkd3d_shader_descriptor_type descriptor_type;
+    struct vkd3d_string_buffer *read, *lod, *name;
+    unsigned int binding = 0, resource_id;
+    const char *type, *rcp;
+    struct msl_dst dst;
+    uint32_t mask;
+    bool uav;
+
+    uav = ins->src[1].reg.type == VKD3DSPR_UAV;
+    descriptor_type = uav ? VKD3D_SHADER_DESCRIPTOR_TYPE_UAV : VKD3D_SHADER_DESCRIPTOR_TYPE_SRV;
+    resource_id = ins->src[1].reg.idx[0].offset;
+    if (!(descriptor = vkd3d_shader_find_descriptor(&gen->program->descriptors, descriptor_type, resource_id))
+            || (descriptor->resource_type != VKD3D_SHADER_RESOURCE_TEXTURE_2D))
+    {
+        msl_compiler_error(gen, VKD3D_SHADER_ERROR_MSL_INTERNAL,
+                "Internal compiler error: resinfo on resource %u is handled for 2D textures only.", resource_id);
+        return;
+    }
+    resource_type_info = msl_get_resource_type_info(VKD3D_SHADER_RESOURCE_TEXTURE_2D);
+    if (!(uav ? msl_get_uav_binding(gen, descriptor, ins->src[1].reg.idx[1].offset, &binding)
+            : msl_get_srv_binding(gen, descriptor, ins->src[1].reg.idx[1].offset, &binding)))
+        msl_compiler_error(gen, VKD3D_SHADER_ERROR_MSL_BINDING_NOT_FOUND,
+                "No descriptor binding specified for %s %u.", uav ? "UAV" : "SRV", resource_id);
+
+    name = vkd3d_string_buffer_get(&gen->string_buffers);
+    if (uav)
+        msl_print_uav_name(name, gen, binding, resource_type_info, descriptor->resource_data_type);
+    else
+        msl_print_srv_name(name, gen, binding, resource_type_info, descriptor->resource_data_type, false);
+    lod = vkd3d_string_buffer_get(&gen->string_buffers);
+    msl_print_src_with_type(lod, gen, &ins->src[0], VKD3DSP_WRITEMASK_0, VSIR_DATA_U32);
+
+    type = ins->flags & VKD3DSI_RESINFO_UINT ? "uint" : "float";
+    rcp = ins->flags & VKD3DSI_RESINFO_RCP_FLOAT ? "1.0f / " : "";
+    mask = msl_dst_init(&dst, gen, ins, &ins->dst[0]);
+    read = vkd3d_string_buffer_get(&gen->string_buffers);
+    vkd3d_string_buffer_printf(read, "as_type<");
+    msl_print_resource_datatype(gen, read, ins->dst[0].reg.data_type);
+    if (vkd3d_popcount(mask) != 1)
+        vkd3d_string_buffer_printf(read, "%u", vkd3d_popcount(mask));
+    if (uav)
+        vkd3d_string_buffer_printf(read, ">(%s4(%s%s(%s.get_width()), %s%s(%s.get_height()), %s(0), %s(1))",
+                type, rcp, type, name->buffer, rcp, type, name->buffer, type, type);
+    else
+        vkd3d_string_buffer_printf(read, ">(%s4(%s%s(%s.get_width(%s)), %s%s(%s.get_height(%s)), %s(0), %s(%s.get_num_mip_levels()))",
+                type, rcp, type, name->buffer, lod->buffer, rcp, type, name->buffer, lod->buffer, type, type, name->buffer);
+    msl_print_swizzle(read, ins->src[1].swizzle, mask);
+    vkd3d_string_buffer_printf(read, ")");
+    msl_print_assignment(gen, &dst, "%s", read->buffer);
+
+    vkd3d_string_buffer_release(&gen->string_buffers, read);
+    vkd3d_string_buffer_release(&gen->string_buffers, lod);
+    vkd3d_string_buffer_release(&gen->string_buffers, name);
+    msl_dst_cleanup(&dst, &gen->string_buffers);
+}
