build/wine-mono/wine-mono-*

# Microsoft Visual C++ runtime redistributables.
# Microsoft-authored binaries, redistributable only under the Visual Studio
# redistributable terms and only unmodified. Not ours to ship -- obtain them
# yourself, see tools/fetch-vcruntime.md.
app/Madeira/x86_64-vcruntime/*.dll

