# crosire's d3d8to9 and cnc-ddraw (tools/build-d3d8to9-dll.sh, tools/build-cnc-ddraw-dll.sh): the work directories; the DLLs go into the ignored i386 farm.
build/d3d8to9/
build/cnc-ddraw/
__pycache__/
# The i386 farm (32-bit Wine + DXMT DLLs) is built from the pinned submodules by
# build/wine-i386/build.sh (docs/WOW64.md section 9); it is not committed.
app/Madeira/i386-windows/*
!app/Madeira/i386-windows/.gitkeep
# BCD's 32-bit test programs (tools/build-dx-tests.sh) are tracked: the fallback when a build has no llvm-mingw
!app/Madeira/i386-windows/*-test-x86.exe

